## Task 1: Climbing expeditions

The 2020-09-22 TidyTueday datasets are about climbing expeditions. From the three datasets, use the "expeditions". Reproduce the plot below! Notice a few things:

-   Use `forcats::fct_lump()` to get the 15 most frequent peaks, and drop the "Other" category.
-   The bars are ordered by the sum of all expeditions (use `fct_reorder()`).
-   The bar colors use the viridis palette and light theme.

```{r}
# Load the expedition dataset
expeditions <- readr::read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2020/2020-09-22/expeditions.csv"
)

# Select the 15 most frequent peaks
expeditions_top15 <- expeditions |>
  dplyr::mutate(
    peak_name = forcats::fct_lump(peak_name, n = 15)
  ) |>
  dplyr::filter(peak_name != "Other")

# Create the stacked bar plot
expeditions_top15 |>
  dplyr::count(peak_name, season) |>
  dplyr::mutate(
    peak_name = forcats::fct_reorder(
      peak_name, n, .fun = sum
    )
  ) |>
  ggplot2::ggplot(
    ggplot2::aes(x = peak_name, y = n, fill = season)
  ) +
  ggplot2::geom_col() +
  ggplot2::coord_flip() +
  ggplot2::scale_fill_viridis_d() +
  ggplot2::theme_light() +
  ggplot2::labs(
    title = "The 15 most popular peaks stacked by season of expedition",
    x = NULL,
    y = "Number of expeditions",
    fill = "season"
  ) +
  ggplot2::theme(
    legend.position = "bottom"
  )
```

## Task 2: PhDs awarded

The 2019-02-19 TidyTueday dataset is about phd-s awarded by year and field. There is only one dataset, it is called `phd_by_field`. Reproduce the plot below!

Notes:

-   First you have to aggregate the data to count all phd-s by broad fields.
-   To make the x axis breaks pretty, use `scales::pretty_breaks()`, to make the y axis labels comma formatted, use `scales::comma_format()`.
-   The line size is 1.2, the colors are from the brewer "Dark2" palette. The theme is set to minimal.

```{r}
phd_by_field <- readr::read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2019/2019-02-19/phd_by_field.csv"
)

head(phd_by_field)
glimpse(phd_by_field)

phd_summary <- phd_by_field |>
  group_by(year, broad_field) |>
  summarise(
    total_phds = sum(n_phds, na.rm = TRUE),
    .groups = "drop"
  )

head(phd_summary)

ggplot(
  phd_summary,
  aes(x = year, y = total_phds, color = broad_field)
) +
  geom_line(linewidth = 1.2) +
  scale_x_continuous(
    breaks = scales::pretty_breaks()
  ) +
  scale_y_continuous(
    labels = scales::comma_format()
  ) +
  scale_color_brewer(palette = "Dark2") +
  labs(
    title = "Number of awarded Ph.D.-s in the US by year",
    x = NULL,
    y = NULL,
    color = "Broad field"
  ) +
  theme_minimal()
```

## Task 3: Commute in the US

The 2019-11-05 TidyTueday dataset is about commuting to work in each city in the US by bike or on foot. There is only one dataset, it is called `commute`. Reproduce the plot below!

Notes:

-   First you have to aggregate the data to count all commutes by state.
-   Both axis scales are log transformed and the labels comma formatted, using `scales::comma_format()`
-   The point size is 2, . The theme is set to light.

```{r}
# Load the dataset
commute <- readr::read_csv(
  "https://raw.githubusercontent.com/rfordatascience/tidytuesday/main/data/2019/2019-11-05/commute.csv"
)

# Aggregate commuters by state and transport mode
commute_summary <- commute |>
  dplyr::group_by(state_abb, state_region, mode) |>
  dplyr::summarise(
    total = sum(n, na.rm = TRUE),
    .groups = "drop"
  )

# Create separate columns for walking and biking
commute_wide <- commute_summary |>
  tidyr::pivot_wider(
    names_from = mode,
    values_from = total
  )

# Create the scatter plot
commute_wide |>
  dplyr::filter(Walk > 0, Bike > 0) |>
  ggplot2::ggplot(
    ggplot2::aes(
      x = Walk,
      y = Bike,
      color = state_region
    )
  ) +
  ggplot2::geom_point(size = 2) +
  ggplot2::geom_text(
    data = function(x) dplyr::filter(x, !is.na(state_abb)),
    ggplot2::aes(label = state_abb),
    color = "black",
    size = 4,
    vjust = -0.2
  ) +
  ggplot2::scale_x_log10(
    labels = scales::comma_format()
  ) +
  ggplot2::scale_y_log10(
    labels = scales::comma_format()
  ) +
  ggplot2::labs(
    title = "Title number of people walking vs. biking to work in each USA state",
    x = "Number of ppl walking to work (log N)",
    y = "Number of ppl biking to work (log N)",
    color = "State region"
  ) +
  ggplot2::theme_light()

```
